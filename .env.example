# Copia este archivo a .env.local y completa los valores.
# Estos valores NO se suben al repositorio. Nunca uses la service key en el cliente.

# Supabase (URL del proyecto + anon/public key)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# Sin estas variables, la app funciona en modo "demostración" (sin persistencia).
